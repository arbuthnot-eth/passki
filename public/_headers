/assets/*
  Cache-Control: public, max-age=31536000, immutable

/dist/*
  Cache-Control: public, max-age=31536000, immutable

# Anti-clickjacking: the app may only be framed by passki itself (both
# domains are the same Worker). /embed is the one page any site may frame —
# a read-only widget with no signing, used by embed.js.
/*
  Content-Security-Policy: frame-ancestors 'self' https://sui.ski https://*.sui.ski https://passki.xyz https://*.passki.xyz

/embed
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors *

/embed.html
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors *

# Stable URL third-party sites embed; short cache so fixes reach them.
/embed.js
  Cache-Control: public, max-age=600
